# VIT Food Spot Guide - Example Environment Configuration
PORT=5000
NODE_ENV=development

# Relational Database (MySQL + JDBC)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vit_food_spots
MYSQL_USER=root
MYSQL_PASSWORD=

# Session Security (Module 6)
SESSION_SECRET=vit_campus_food_spot_secret_key_2026_secure

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vitfoodguide2026

# AI Chatbot Configuration
# Grok API (xAI) or Gemini API (Optional: rule-based engine operates automatically when key is omitted)
GROK_API_KEY=your_xai_grok_api_key_here
GEMINI_API_KEY=
FALLBACK_ENABLED=true

CLIENT_URL=http://localhost:5000
